# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# AWS
AWS_REGION=us-east-1
# Copy this exact model ID string from the AWS Bedrock console > Model access.
# Do NOT type this from memory — model IDs change and a wrong guess either
# fails loudly (fine) or silently calls a different, possibly pricier model (not fine).
BEDROCK_MODEL_ID=

# Gmail OAuth (Stage 1 track A produces these files, not these exact values)
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# SES (used starting Stage 3)
SES_SENDER_EMAIL=
SES_RECIPIENT_EMAIL=
